# Copie para .env e carregue com: set -a; source .env; set +a
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL da API Flask (local por padrão)
CONCURSOS_API_URL=http://127.0.0.1:5000

# Estados a monitorar (br = nacional), separados por vírgula
UFS=rj,br
# open, expected, closed
STATUSES=open
# Filtro opcional por nome do órgão (ex.: prefeitura,tribunal,banco)
KEYWORDS=
